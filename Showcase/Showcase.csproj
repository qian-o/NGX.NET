<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>$(StandardTargetFramework)</TargetFramework>
        <PlatformTarget>x64</PlatformTarget>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Streamline.NET\Streamline.NET.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="ImGui.NET" />
        <PackageReference Include="SharpGLTF.Core" />
        <PackageReference Include="Slangc.NET" />
        <PackageReference Include="StbImageSharp" />
        <PackageReference Include="Vortice.Direct3D12" />
        <PackageReference Include="Vortice.DXGI" />
        <PackageReference Include="Vortice.Vulkan" />
    </ItemGroup>

    <ItemGroup>
        <None Update="Assets\Shaders\**;Assets\Scenes\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Remove="Assets\Streamline\**" />
        <Content Include="Assets\Streamline\sl.interposer.*;Assets\Streamline\sl.common.*;Assets\Streamline\sl.dlss*;Assets\Streamline\sl.reflex.*;Assets\Streamline\sl.pcl.*;Assets\Streamline\nvngx_dlss*;Assets\Streamline\NvLowLatencyVk.*;Assets\Streamline\reflex.license.*;Assets\Streamline\streamline-runtime.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <TargetPath>%(Filename)%(Extension)</TargetPath>
        </Content>
        <Content Include="Assets\Streamline\Licenses\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <TargetPath>Licenses\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
        </Content>
    </ItemGroup>

</Project>
