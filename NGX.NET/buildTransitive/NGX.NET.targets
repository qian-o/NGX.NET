<Project>

    <Import Project="$(MSBuildThisFileDirectory)NGX.NET.props" Condition="'$(_NgxSdkRelease)' == ''" />

    <UsingTask TaskName="NgxResolveRuntime"
               TaskFactory="RoslynCodeTaskFactory"
               AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <Task>
            <Code Type="Class" Language="cs">
<![CDATA[
using System;
using System.Collections.Generic;
using System.IO;
using System.Net;
using System.Net.Http;
using System.Security.Cryptography;
using System.Threading;
using System.Threading.Tasks;
using Microsoft.Build.Framework;
using Microsoft.Build.Utilities;

namespace NGX.NET.Tasks
{
    public sealed class NgxResolveRuntime : Microsoft.Build.Utilities.Task, ICancelableTask
    {
        private const int MaxAttempts = 3;
        private const int ReadTimeoutSeconds = 60;
        private const int BufferSize = 64 * 1024;
        private static readonly StringComparison PathComparison = Path.DirectorySeparatorChar == '\\' ? StringComparison.OrdinalIgnoreCase : StringComparison.Ordinal;
        private static readonly StringComparer PathComparer = Path.DirectorySeparatorChar == '\\' ? StringComparer.OrdinalIgnoreCase : StringComparer.Ordinal;
        private readonly CancellationTokenSource cancellation = new CancellationTokenSource();

        [Required] public ITaskItem[] RuntimeItems { get; set; }
        [Required] public ITaskItem[] ManifestEntries { get; set; }
        [Required] public string ProjectDirectory { get; set; }
        [Required] public string CacheDirectory { get; set; }
        [Required] public string DefaultBaseUrl { get; set; }
        [Required] public string SdkRelease { get; set; }
        public string RuntimeIdentifier { get; set; }
        public string RuntimeIdentifiers { get; set; }
        [Output] public ITaskItem[] ResolvedAssets { get; set; }

        private sealed class DownloadEntry
        {
            public string Rid;
            public string AssetName;
            public string DownloadUrl;
            public string CachedPath;
            public string Sha256;
        }

        public void Cancel()
        {
            try { cancellation.Cancel(); }
            catch (ObjectDisposedException) { }
        }

        public override bool Execute()
        {
            try { return ExecuteAsync().GetAwaiter().GetResult(); }
            catch (OperationCanceledException) { Log.LogMessage(MessageImportance.High, "NGX.NET: Runtime asset resolution canceled."); return false; }
            finally { cancellation.Dispose(); }
        }

        private async Task<bool> ExecuteAsync()
        {
            ResolvedAssets = Array.Empty<ITaskItem>();
            if ((RuntimeItems == null) || (RuntimeItems.Length == 0))
            {
                return true;
            }

            List<string> supportedRids = new List<string>();
            Dictionary<string, List<ITaskItem>> manifestByRid = new Dictionary<string, List<ITaskItem>>(StringComparer.OrdinalIgnoreCase);
            foreach (ITaskItem entry in ManifestEntries)
            {
                string rid = entry.GetMetadata("Rid").Trim().ToLowerInvariant();
                if (!manifestByRid.ContainsKey(rid))
                {
                    supportedRids.Add(rid);
                    manifestByRid[rid] = new List<ITaskItem>();
                }
                manifestByRid[rid].Add(entry);
            }

            Dictionary<string, List<string>> configs = new Dictionary<string, List<string>>(StringComparer.OrdinalIgnoreCase);
            Dictionary<string, string> allRoots = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            HashSet<string> explicitLocalRids = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

            foreach (ITaskItem item in RuntimeItems)
            {
                string spec = (item.ItemSpec ?? string.Empty).Trim();
                string rawPath = (item.GetMetadata("Path") ?? string.Empty).Trim();

                if (string.Equals(spec, "All", StringComparison.OrdinalIgnoreCase))
                {
                    string rootDir = rawPath.Length == 0 ? null : ResolveUserPath(rawPath, ProjectDirectory);
                    foreach (string rid in supportedRids)
                    {
                        explicitLocalRids.Remove(rid);
                        if (rootDir == null)
                        {
                            configs[rid] = null;
                            allRoots.Remove(rid);
                        }
                        else
                        {
                            configs[rid] = new List<string> { Path.Combine(rootDir, rid) };
                            allRoots[rid] = rootDir;
                        }
                    }
                    continue;
                }

                string canonicalRid = supportedRids.Find(r => string.Equals(r, spec, StringComparison.OrdinalIgnoreCase));
                if (canonicalRid == null)
                {
                    Log.LogError("NGX.NET: Invalid NGXRuntime Include '{0}'. Expected 'All' or one of: {1}.", spec, string.Join(", ", supportedRids));
                    return false;
                }

                allRoots.Remove(canonicalRid);
                if (rawPath.Length == 0)
                {
                    explicitLocalRids.Remove(canonicalRid);
                    configs[canonicalRid] = null;
                }
                else
                {
                    string fullPath = ResolveUserPath(rawPath, ProjectDirectory);
                    if (explicitLocalRids.Add(canonicalRid))
                    {
                        configs[canonicalRid] = new List<string> { fullPath };
                    }
                    else
                    {
                        configs[canonicalRid].Add(fullPath);
                    }
                }
            }

            HashSet<string> activeRids = ParseActiveRids(RuntimeIdentifier, RuntimeIdentifiers);
            List<string> selectedRids = supportedRids.FindAll(r => configs.ContainsKey(r) && ((activeRids == null) || activeRids.Contains(r)));
            if (selectedRids.Count == 0)
            {
                return true;
            }

            List<ITaskItem> output = new List<ITaskItem>();
            List<DownloadEntry> downloadEntries = new List<DownloadEntry>();
            Dictionary<string, int> rootHits = new Dictionary<string, int>(PathComparer);
            List<string> rootsSeen = new List<string>();

            foreach (string rid in selectedRids)
            {
                cancellation.Token.ThrowIfCancellationRequested();
                List<string> localPaths = configs[rid];
                if (localPaths == null)
                {
                    foreach (ITaskItem entry in manifestByRid[rid])
                    {
                        string assetName = entry.GetMetadata("AssetName");
                        string cachedPath = Path.GetFullPath(Path.Combine(CacheDirectory, rid, assetName));
                        downloadEntries.Add(new DownloadEntry
                        {
                            Rid = rid,
                            AssetName = assetName,
                            DownloadUrl = DefaultBaseUrl.TrimEnd('/') + "/" + entry.GetMetadata("RelativeUrl").TrimStart('/'),
                            CachedPath = cachedPath,
                            Sha256 = entry.GetMetadata("Sha256")
                        });
                        output.Add(CreateAssetItem(rid, assetName, cachedPath));
                    }
                    continue;
                }

                string allRoot;
                bool isFromAll = allRoots.TryGetValue(rid, out allRoot);
                if (isFromAll && !rootHits.ContainsKey(allRoot))
                {
                    if (!Directory.Exists(allRoot))
                    {
                        Log.LogError("NGX.NET: Runtime directory '{0}' specified in NGXRuntime does not exist.", allRoot);
                        return false;
                    }
                    rootHits[allRoot] = 0;
                    rootsSeen.Add(allRoot);
                }

                Dictionary<string, string> filesByName = new Dictionary<string, string>(rid.StartsWith("win-", StringComparison.OrdinalIgnoreCase) ? StringComparer.OrdinalIgnoreCase : StringComparer.Ordinal);
                foreach (string localPath in localPaths)
                {
                    if (File.Exists(localPath))
                    {
                        string fileName = Path.GetFileName(localPath);
                        if (IsCoreNativeBinary(fileName) || !IsValidRuntimeFileName(rid, fileName))
                        {
                            Log.LogError("NGX.NET: File '{0}' is not a valid runtime library for '{1}'.", localPath, rid);
                            return false;
                        }
                        if (!AddFile(filesByName, fileName, localPath, rid))
                        {
                            return false;
                        }
                    }
                    else if (Directory.Exists(localPath))
                    {
                        int before = filesByName.Count;
                        string[] candidates = Directory.GetFiles(localPath);
                        Array.Sort(candidates, StringComparer.Ordinal);
                        foreach (string candidate in candidates)
                        {
                            string fileName = Path.GetFileName(candidate);
                            if (IsValidRuntimeFileName(rid, fileName) && !AddFile(filesByName, fileName, candidate, rid))
                            {
                                return false;
                            }
                        }
                        if ((filesByName.Count == before) && (!isFromAll || (activeRids != null)))
                        {
                            Log.LogError("NGX.NET: No runtime libraries for '{0}' were found in '{1}'.", rid, localPath);
                            return false;
                        }
                    }
                    else if (!isFromAll || (activeRids != null))
                    {
                        Log.LogError("NGX.NET: Runtime path '{0}' for '{1}' does not exist.", localPath, rid);
                        return false;
                    }
                }

                if (isFromAll)
                {
                    rootHits[allRoot] += filesByName.Count;
                }

                List<string> names = new List<string>(filesByName.Keys);
                names.Sort(StringComparer.Ordinal);
                foreach (string name in names)
                {
                    output.Add(CreateAssetItem(rid, name, filesByName[name]));
                }
            }

            foreach (string rootDir in rootsSeen)
            {
                if (rootHits[rootDir] == 0)
                {
                    Log.LogError("NGX.NET: No '<rid>' subdirectories containing runtime libraries were found under '{0}'.", rootDir);
                    return false;
                }
            }

            if ((downloadEntries.Count > 0) && !await EnsureDownloadedAsync(downloadEntries).ConfigureAwait(false))
            {
                return false;
            }

            ResolvedAssets = output.ToArray();
            return true;
        }

        private async Task<bool> EnsureDownloadedAsync(List<DownloadEntry> entries)
        {
            if (GetPending(entries).Count == 0)
            {
                return true;
            }

            Directory.CreateDirectory(CacheDirectory);
            using (AcquireLock(Path.Combine(CacheDirectory, ".lock")))
            {
                List<DownloadEntry> pending = GetPending(entries);
                if (pending.Count == 0)
                {
                    return true;
                }

                string tempRoot = Path.Combine(CacheDirectory, ".tmp-" + Guid.NewGuid().ToString("N"));
                try
                {
                    using (HttpClient client = new HttpClient { Timeout = Timeout.InfiniteTimeSpan })
                    {
                        client.DefaultRequestHeaders.UserAgent.ParseAdd("NGX.NET");
                        for (int i = 0; i < pending.Count; i++)
                        {
                            if (!await DownloadWithRetryAsync(client, pending[i], i + 1, pending.Count, tempRoot).ConfigureAwait(false))
                            {
                                return false;
                            }
                        }
                        return true;
                    }
                }
                finally
                {
                    try { if (Directory.Exists(tempRoot)) Directory.Delete(tempRoot, true); } catch { }
                }
            }
        }

        private List<DownloadEntry> GetPending(List<DownloadEntry> entries)
        {
            List<DownloadEntry> pending = new List<DownloadEntry>();
            foreach (DownloadEntry entry in entries)
            {
                cancellation.Token.ThrowIfCancellationRequested();
                bool valid = false;
                if (File.Exists(entry.CachedPath))
                {
                    try { valid = string.Equals(ComputeSha256(entry.CachedPath), entry.Sha256, StringComparison.OrdinalIgnoreCase); }
                    catch (IOException) { valid = false; }
                }
                if (!valid)
                {
                    pending.Add(entry);
                }
            }
            return pending;
        }

        private FileStream AcquireLock(string lockPath)
        {
            while (true)
            {
                cancellation.Token.ThrowIfCancellationRequested();
                try { return new FileStream(lockPath, FileMode.OpenOrCreate, FileAccess.ReadWrite, FileShare.None); }
                catch (IOException) { cancellation.Token.WaitHandle.WaitOne(250); }
            }
        }

        private async Task<bool> DownloadWithRetryAsync(HttpClient client, DownloadEntry entry, int index, int totalCount, string tempRoot)
        {
            string tempFile = Path.Combine(tempRoot, entry.Rid, entry.AssetName);
            for (int attempt = 1; ; attempt++)
            {
                cancellation.Token.ThrowIfCancellationRequested();
                try
                {
                    using (CancellationTokenSource attemptCts = CancellationTokenSource.CreateLinkedTokenSource(cancellation.Token))
                    using (HttpRequestMessage request = new HttpRequestMessage(HttpMethod.Get, entry.DownloadUrl))
                    {
                        attemptCts.CancelAfter(TimeSpan.FromSeconds(ReadTimeoutSeconds));
                        using (HttpResponseMessage response = await client.SendAsync(request, HttpCompletionOption.ResponseHeadersRead, attemptCts.Token).ConfigureAwait(false))
                        {
                            int statusCode = (int)response.StatusCode;
                            if ((statusCode >= 400) && (statusCode < 500) && (response.StatusCode != (HttpStatusCode)408) && (response.StatusCode != (HttpStatusCode)429))
                            {
                                Log.LogError("NGX.NET: Failed to download '{0}' from '{1}': HTTP {2}.", entry.AssetName, entry.DownloadUrl, statusCode);
                                return false;
                            }

                            response.EnsureSuccessStatusCode();
                            Log.LogMessage(MessageImportance.High, "NGX.NET: [{0}/{1}] Downloading {2}/{3} ({4})...", index, totalCount, entry.Rid, entry.AssetName, SdkRelease);

                            Directory.CreateDirectory(Path.GetDirectoryName(tempFile));
                            string actualSha256;
                            using (Stream responseStream = await response.Content.ReadAsStreamAsync().ConfigureAwait(false))
                            using (FileStream fileStream = new FileStream(tempFile, FileMode.Create, FileAccess.Write, FileShare.None, BufferSize, useAsync: true))
                            using (SHA256 sha256 = SHA256.Create())
                            {
                                byte[] buffer = new byte[BufferSize];
                                while (true)
                                {
                                    attemptCts.CancelAfter(TimeSpan.FromSeconds(ReadTimeoutSeconds));
                                    int read = await responseStream.ReadAsync(buffer, 0, buffer.Length, attemptCts.Token).ConfigureAwait(false);
                                    if (read == 0) break;
                                    sha256.TransformBlock(buffer, 0, read, null, 0);
                                    await fileStream.WriteAsync(buffer, 0, read, cancellation.Token).ConfigureAwait(false);
                                }
                                sha256.TransformFinalBlock(Array.Empty<byte>(), 0, 0);
                                actualSha256 = BitConverter.ToString(sha256.Hash).Replace("-", string.Empty);
                            }

                            if (!string.Equals(actualSha256, entry.Sha256, StringComparison.OrdinalIgnoreCase))
                            {
                                Log.LogError("NGX.NET: SHA-256 verification failed for '{0}'. Expected {1}, got {2}.", entry.AssetName, entry.Sha256, actualSha256);
                                return false;
                            }

                            Directory.CreateDirectory(Path.GetDirectoryName(entry.CachedPath));
                            if (File.Exists(entry.CachedPath)) File.Replace(tempFile, entry.CachedPath, null);
                            else File.Move(tempFile, entry.CachedPath);
                            return true;
                        }
                    }
                }
                catch (Exception ex) when ((ex is OperationCanceledException) || (ex is HttpRequestException) || (ex is IOException))
                {
                    try { if (File.Exists(tempFile)) File.Delete(tempFile); } catch { }
                    if (cancellation.IsCancellationRequested) throw new OperationCanceledException(cancellation.Token);
                    if (attempt >= MaxAttempts)
                    {
                        Log.LogError("NGX.NET: Failed downloading '{0}' from '{1}': {2}", entry.AssetName, entry.DownloadUrl, ex.Message);
                        return false;
                    }
                    cancellation.Token.WaitHandle.WaitOne(1000 * attempt);
                }
            }
        }

        private bool AddFile(Dictionary<string, string> filesByName, string fileName, string fullPath, string rid)
        {
            string existingPath;
            if (filesByName.TryGetValue(fileName, out existingPath) && !string.Equals(existingPath, fullPath, PathComparison))
            {
                Log.LogError("NGX.NET: Duplicate runtime file '{0}' for '{1}' specified at both '{2}' and '{3}'.", fileName, rid, existingPath, fullPath);
                return false;
            }
            filesByName[fileName] = fullPath;
            return true;
        }

        private static ITaskItem CreateAssetItem(string rid, string assetName, string sourcePath)
        {
            TaskItem item = new TaskItem(sourcePath);
            item.SetMetadata("Rid", rid);
            item.SetMetadata("AssetName", assetName);
            return item;
        }

        private static HashSet<string> ParseActiveRids(string runtimeIdentifier, string runtimeIdentifiers)
        {
            string raw = !string.IsNullOrWhiteSpace(runtimeIdentifier) ? runtimeIdentifier : runtimeIdentifiers;
            if (string.IsNullOrWhiteSpace(raw)) return null;
            HashSet<string> result = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (string part in raw.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries))
            {
                string trimmed = part.Trim().ToLowerInvariant();
                if (trimmed.Length > 0) result.Add(trimmed);
            }
            return result.Count > 0 ? result : null;
        }

        private static string ResolveUserPath(string rawPath, string projectDirectory)
        {
            string normalized = rawPath.Replace('\\', Path.DirectorySeparatorChar).Replace('/', Path.DirectorySeparatorChar);
            string fullPath = Path.GetFullPath(Path.IsPathRooted(normalized) ? normalized : Path.Combine(projectDirectory, normalized));
            return string.Equals(fullPath, Path.GetPathRoot(fullPath), StringComparison.OrdinalIgnoreCase)
                ? fullPath
                : fullPath.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
        }

        private static bool IsCoreNativeBinary(string fileName)
        {
            return string.Equals(fileName, "ngx-bridge.dll", StringComparison.OrdinalIgnoreCase)
                || string.Equals(fileName, "libngx-bridge.so", StringComparison.OrdinalIgnoreCase);
        }

        private static bool IsValidRuntimeFileName(string rid, string fileName)
        {
            if (IsCoreNativeBinary(fileName)) return false;
            if (rid.StartsWith("win-", StringComparison.OrdinalIgnoreCase)) return fileName.EndsWith(".dll", StringComparison.OrdinalIgnoreCase);
            return fileName.EndsWith(".so", StringComparison.OrdinalIgnoreCase) || HasNumericSoSuffix(fileName);
        }

        private static bool HasNumericSoSuffix(string fileName)
        {
            int markerIndex = fileName.IndexOf(".so.", StringComparison.Ordinal);
            if (markerIndex <= 0) return false;
            string suffix = fileName.Substring(markerIndex + 4);
            if (suffix.Length == 0) return false;
            foreach (string segment in suffix.Split('.'))
            {
                if (segment.Length == 0) return false;
                for (int i = 0; i < segment.Length; i++)
                {
                    if ((segment[i] < '0') || (segment[i] > '9')) return false;
                }
            }
            return true;
        }

        private static string ComputeSha256(string path)
        {
            using (FileStream stream = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.Read))
            using (SHA256 sha256 = SHA256.Create())
            {
                return BitConverter.ToString(sha256.ComputeHash(stream)).Replace("-", string.Empty);
            }
        }
    }
}
]]>
            </Code>
        </Task>
    </UsingTask>

    <Target Name="_NgxInitializeRuntimeLayout"
            Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">

        <PropertyGroup>
            <_NgxNormalizedRids Condition="'$(RuntimeIdentifier)' != ''">;$(RuntimeIdentifier.Trim().ToLowerInvariant());</_NgxNormalizedRids>
            <_NgxNormalizedRids Condition="'$(_NgxNormalizedRids)' == '' and '$(RuntimeIdentifiers)' != ''">;$([System.Text.RegularExpressions.Regex]::Replace('$(RuntimeIdentifiers)', '\s+', '').ToLowerInvariant());</_NgxNormalizedRids>

            <_NgxCacheRoot Condition="'$(_NgxCacheRoot)' == ''">$([System.IO.Path]::GetTempPath())</_NgxCacheRoot>
            <_NgxCacheBaseDir>$([System.IO.Path]::GetFullPath('$([System.IO.Path]::Combine('$(_NgxCacheRoot)', 'NGX.NET', 'cache', '$(_NgxSdkRelease)'))'))</_NgxCacheBaseDir>
        </PropertyGroup>

    </Target>

    <Target Name="_NgxResolveRuntimeAssets"
            DependsOnTargets="_NgxInitializeRuntimeLayout"
            Condition="'@(NGXRuntime)' != '' and '$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">

        <NgxResolveRuntime RuntimeItems="@(NGXRuntime)"
                           ManifestEntries="@(_NgxManifestEntry)"
                           ProjectDirectory="$(MSBuildProjectDirectory)"
                           CacheDirectory="$(_NgxCacheBaseDir)"
                           DefaultBaseUrl="$(_NgxDefaultBaseUrl)"
                           SdkRelease="$(_NgxSdkRelease)"
                           RuntimeIdentifier="$(RuntimeIdentifier)"
                           RuntimeIdentifiers="$(RuntimeIdentifiers)">
            <Output TaskParameter="ResolvedAssets" ItemName="_NgxResolvedAsset" />
        </NgxResolveRuntime>

    </Target>

    <Target Name="_NgxGetTransitiveRuntimeAssets"
            DependsOnTargets="_NgxResolveRuntimeAssets;_SplitProjectReferencesByFileExistence;_GetProjectReferenceTargetFrameworkProperties"
            Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'"
            Returns="@(_NgxTransitiveRuntimeAsset)">

        <MSBuild Projects="@(_MSBuildProjectReferenceExistent)"
                 Targets="_NgxGetTransitiveRuntimeAssets"
                 BuildInParallel="$(BuildInParallel)"
                 Properties="%(_MSBuildProjectReferenceExistent.SetConfiguration); %(_MSBuildProjectReferenceExistent.SetPlatform); %(_MSBuildProjectReferenceExistent.SetTargetFramework)"
                 Condition="'@(_MSBuildProjectReferenceExistent)' != '' and '%(_MSBuildProjectReferenceExistent.Private)' != 'false' and '$(UseCommonOutputDirectory)' != 'true'"
                 ContinueOnError="$(ContinueOnError)"
                 SkipNonexistentTargets="true"
                 RemoveProperties="%(_MSBuildProjectReferenceExistent.GlobalPropertiesToRemove)$(_GlobalPropertiesToRemoveFromProjectReferences)">
            <Output TaskParameter="TargetOutputs" ItemName="_NgxChildRuntimeAsset" />
        </MSBuild>

        <ItemGroup>
            <_NgxTransitiveRuntimeAsset Include="@(_NgxChildRuntimeAsset)" Condition="'@(NGXRuntime)' == ''" />
            <_NgxTransitiveRuntimeAsset Include="@(_NgxResolvedAsset)" Condition="'@(_NgxResolvedAsset)' != ''">
                <_NgxRid>%(_NgxResolvedAsset.Rid)</_NgxRid>
                <_NgxAssetName>%(_NgxResolvedAsset.AssetName)</_NgxAssetName>
            </_NgxTransitiveRuntimeAsset>
        </ItemGroup>

    </Target>

    <Target Name="_NgxStageBuildRuntimeAssets"
            AfterTargets="GetCopyToOutputDirectoryItems"
            DependsOnTargets="_NgxInitializeRuntimeLayout;_NgxGetTransitiveRuntimeAssets"
            Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">

        <ItemGroup Condition="'@(_NgxChildRuntimeAsset)' != ''">
            <_SourceItemsToCopyToOutputDirectory Remove="@(_NgxChildRuntimeAsset)" />
            <AllItemsFullPathWithTargetPath Remove="@(_NgxChildRuntimeAsset)" />
        </ItemGroup>

        <ItemGroup Condition="'@(_NgxTransitiveRuntimeAsset)' != ''">
            <_NgxBuildCandidate Include="@(_NgxTransitiveRuntimeAsset)"
                                Condition="'$(_NgxNormalizedRids)' == '' or $(_NgxNormalizedRids.Contains(';%(_NgxTransitiveRuntimeAsset._NgxRid);'))">
                <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                <TargetPath Condition="'$(RuntimeIdentifier)' != ''">%(_NgxTransitiveRuntimeAsset._NgxAssetName)</TargetPath>
                <TargetPath Condition="'$(RuntimeIdentifier)' == ''">runtimes/%(_NgxTransitiveRuntimeAsset._NgxRid)/native/%(_NgxTransitiveRuntimeAsset._NgxAssetName)</TargetPath>
            </_NgxBuildCandidate>

            <_NgxBuildDedupInput Include="@(_NgxBuildCandidate->'%(TargetPath)')" OriginalIdentity="%(Identity)" />
        </ItemGroup>

        <RemoveDuplicates Inputs="@(_NgxBuildDedupInput)" Condition="'@(_NgxBuildDedupInput)' != ''">
            <Output TaskParameter="Filtered" ItemName="_NgxBuildDedup" />
        </RemoveDuplicates>

        <ItemGroup Condition="'@(_NgxBuildDedup)' != ''">
            <_SourceItemsToCopyToOutputDirectory Include="@(_NgxBuildDedup->'%(OriginalIdentity)')" />
            <AllItemsFullPathWithTargetPath Include="@(_NgxBuildDedup->'%(OriginalIdentity)')" />
        </ItemGroup>

    </Target>

    <Target Name="_NgxStagePublishRuntimeAssets"
            AfterTargets="GetCopyToPublishDirectoryItems"
            DependsOnTargets="_NgxInitializeRuntimeLayout;_NgxGetTransitiveRuntimeAssets"
            Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">

        <ItemGroup Condition="'@(_NgxChildRuntimeAsset)' != ''">
            <_SourceItemsToCopyToPublishDirectory Remove="@(_NgxChildRuntimeAsset)" />
            <AllPublishItemsFullPathWithTargetPath Remove="@(_NgxChildRuntimeAsset)" />
        </ItemGroup>

        <ItemGroup Condition="'@(_NgxTransitiveRuntimeAsset)' != ''">
            <_NgxPublishCandidate Include="@(_NgxTransitiveRuntimeAsset)"
                                  Condition="'$(_NgxNormalizedRids)' == '' or $(_NgxNormalizedRids.Contains(';%(_NgxTransitiveRuntimeAsset._NgxRid);'))">
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
                <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
                <TargetPath Condition="'$(RuntimeIdentifier)' != ''">%(_NgxTransitiveRuntimeAsset._NgxAssetName)</TargetPath>
                <TargetPath Condition="'$(RuntimeIdentifier)' == ''">runtimes/%(_NgxTransitiveRuntimeAsset._NgxRid)/native/%(_NgxTransitiveRuntimeAsset._NgxAssetName)</TargetPath>
            </_NgxPublishCandidate>

            <_NgxPublishDedupInput Include="@(_NgxPublishCandidate->'%(TargetPath)')" OriginalIdentity="%(Identity)" />
        </ItemGroup>

        <RemoveDuplicates Inputs="@(_NgxPublishDedupInput)" Condition="'@(_NgxPublishDedupInput)' != ''">
            <Output TaskParameter="Filtered" ItemName="_NgxPublishDedup" />
        </RemoveDuplicates>

        <ItemGroup Condition="'@(_NgxPublishDedup)' != ''">
            <_SourceItemsToCopyToPublishDirectory Include="@(_NgxPublishDedup->'%(OriginalIdentity)')" />
            <AllPublishItemsFullPathWithTargetPath Include="@(_NgxPublishDedup->'%(OriginalIdentity)')" />
        </ItemGroup>

    </Target>

    <Target Name="_NgxExcludeCoreNativeFromSingleFile"
            AfterTargets="ComputeResolvedFilesToPublishList"
            BeforeTargets="_ComputeFilesToBundle;_ComputeResolvedFilesToPublishTypes"
            Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">

        <ItemGroup>
            <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
                                   Condition="'%(Filename)%(Extension)' == 'ngx-bridge.dll' or '%(Filename)%(Extension)' == 'libngx-bridge.so'">
                <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            </ResolvedFileToPublish>
        </ItemGroup>

    </Target>

</Project>
